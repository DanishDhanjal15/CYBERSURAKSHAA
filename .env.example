# ════════════════════════════════════════════════════
# CYBERSURAKSHAA — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit the actual .env file to git!
# ════════════════════════════════════════════════════

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_here_change_this

# Set to 'production' when deploying (disables debug mode, enables 0.0.0.0 binding)
FLASK_ENV=production

# Port (set automatically by Railway/Render/Cloud Run — don't set manually)
# PORT=8080

# Password for the seeded 'admin' account. REQUIRED when FLASK_ENV=production —
# startup fails rather than seeding a well-known default password.
ADMIN_PASSWORD=change_this_before_deploying

# Background threat crawler. Runs once per process, so with more than one
# gunicorn worker set this to 0 on all but one of them.
ENABLE_CRAWLER=1

# Investment detector Engine B (XLM-RoBERTa).
# ALLOW_HF_DOWNLOAD=0 keeps the app from reaching out to the HuggingFace Hub
# when local weights are absent — useful for offline or air-gapped deploys.
# ALLOW_HF_DOWNLOAD=1
# ENGINE_B_MODEL_ID=nahiar/spam-detection-xlm-roberta-v1

# Betting text classifier: optional transformer model.
# Must be a model fine-tuned for betting classification — a base model has no
# trained classification head and emits meaningless scores.
# USE_BERT=false
# BERT_MODEL_PATH=
